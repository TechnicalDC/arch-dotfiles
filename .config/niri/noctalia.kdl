layout {

    focus-ring {
        active-color   "#f0bf6d"
        inactive-color "#17130b"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#f0bf6d"
        inactive-color "#17130b"
        urgent-color   "#ffb4ab"
    }


    tab-indicator {
        active-color   "#f0bf6d"
        inactive-color "#5f4100"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#f0bf6d80"
    }
}

recent-windows {
    highlight {
        active-color "#f0bf6d"
        urgent-color "#ffb4ab"
    }
}
