layout {

    focus-ring {
        active-color   "#37f499"
        inactive-color "#000000"
        urgent-color   "#f16c75"
    }

    border {
        active-color   "#37f499"
        inactive-color "#000000"
        urgent-color   "#f16c75"
    }


    tab-indicator {
        active-color   "#37f499"
        inactive-color "#276154"
        urgent-color   "#f16c75"
    }

    insert-hint {
        color "#37f49980"
    }
}

recent-windows {
    highlight {
        active-color "#37f499"
        urgent-color "#f16c75"
    }
}
