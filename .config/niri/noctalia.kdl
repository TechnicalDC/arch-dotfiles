layout {

    focus-ring {
        active-color   "#95d5a8"
        inactive-color "#0f1511"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#95d5a8"
        inactive-color "#0f1511"
        urgent-color   "#ffb4ab"
    }


    tab-indicator {
        active-color   "#95d5a8"
        inactive-color "#0f512f"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#95d5a880"
    }
}

recent-windows {
    highlight {
        active-color "#95d5a8"
        urgent-color "#ffb4ab"
    }
}
